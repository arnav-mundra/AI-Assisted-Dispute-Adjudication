# Copy this file to .env and fill in your own keys. Never commit the real .env file.

# Groq serves the adjudication pipeline. This is the only key needed to run.
GROQ_API_KEY=

# Anthropic is implemented but switched off in src/llm/provider.py
# (DISABLED_PROVIDERS). Setting this key alone does not re-enable it.
ANTHROPIC_API_KEY=

# Optional: overrides the default reasoning model (openai/gpt-oss-120b on Groq).
ADJUDICATION_MODEL=

# Database
DATABASE_URL=sqlite:///./data/dispute_adjudication.db

# App
ENV=development
LOG_LEVEL=INFO
